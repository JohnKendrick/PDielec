&CONTROL
  calculation  = "vc-relax",
  prefix       = "ZnO",
  pseudo_dir   = "/home/john/Data/PseudoPotentials/",
  outdir       = ".",
  nstep        = 50,
  etot_conv_thr= 2.0D-7,
  forc_conv_thr= 2.0D-6,
/
&SYSTEM
  ibrav=0, nat=4, ntyp= 2,
  occupations='fixed', 
  ecutwfc    = 100.0, !was 140
  celldm(1) = 6.141610
/
&ELECTRONS
  mixing_mode='plain'
  mixing_beta = 0.5,
  conv_thr =  1.0d-10
  diagonalization='davidson'
/
&IONS
  ion_dynamics = 'bfgs',
  pot_extrapolation = 'none',
  wfc_extrapolation = 'none',
/
&CELL
  cell_dynamics = 'bfgs',
/
CELL_PARAMETERS alat
   0.873655829  -0.504405428  -0.000000000
   0.000000000   1.008810856   0.000000000
  -0.000000000  -0.000000000   1.627605567
ATOMIC_SPECIES
  Zn 65.380  Zn_ONCV_LDA.upf
  O  15.999   O_ONCV_LDA.upf
ATOMIC_POSITIONS {crystal}
Zn               0.3333333333        0.6666666667        0.0016237126
Zn               0.6666666667        0.3333333333        0.5016237126
O                0.3333333333        0.6666666667        0.3808762874
O                0.6666666667        0.3333333333        0.8808762874

K_POINTS automatic
