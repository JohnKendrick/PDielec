# ZnO full-DFPT Raman, modeled on merged t83
# PAW + LDA version first, since that is the working reference route

# --------------------------------------------------
# Structure: wurtzite ZnO primitive cell
# Optimised structure 
# --------------------------------------------------
acell 6.0176973788E+00  6.0176973790E+00  9.7282168388E+00 Bohr

rprim
  0.86602540378 -0.50000000000  0.00000000000
  0.00000000000  1.00000000000  0.00000000000
  0.00000000000  0.00000000000  1.00000000000

natom  4
ntypat 2
znucl  30 8
typat  1 1 2 2

xred     3.3333333333E-01  6.6666666667E-01  2.0444838919E-03
         6.6666666667E-01  3.3333333333E-01  5.0204448389E-01
         3.3333333333E-01  6.6666666667E-01  3.8045551611E-01
         6.6666666667E-01  3.3333333333E-01  8.8045551611E-01

# --------------------------------------------------
# XC and PAW
# --------------------------------------------------
ixc 7
pawxcdev 0

# --------------------------------------------------
# SCF / basis
# --------------------------------------------------
nstep    100
occopt   1

# Check nband against your PAW valence setup
nband    30

# Starting values only: adjust if your PAW datasets require more
ecut      30
ecutsm     0
pawecutdg 60
nbdbuf     4  # Attempt to speed up the SCF convergence

# --------------------------------------------------
# K mesh
# --------------------------------------------------
ngkpt    6 6 4
nshiftk  1
shiftk   0.0 0.0 0.5

# --------------------------------------------------
# Datasets
# --------------------------------------------------
ndtset 7
jdtset 1 2 3 4 5 6 7

# For all datasets except 1 and 2
kptopt  2
tolvrs  1.0d-18
tolwfr  1.0E-11
getden  2
getwfk  2

# --------------------------------------------------
# DS1: Ground-state density
# --------------------------------------------------
getden1  0
getwfk1  0
tolvrs1  1.0d-8
kptopt1  1
prtden1  1

# --------------------------------------------------
# DS2: Highly converged wavefunctions
# --------------------------------------------------
getden2  1
getwfk2  1
tolvrs2  1.0d-18
prtwf2   1

# --------------------------------------------------
# DS3: DDK
# --------------------------------------------------
rfddk3   1
nstep3   1
nline3   100
tolrde3  1.0d-30

# --------------------------------------------------
# DS4: Phonons + electric field
# --------------------------------------------------
rfelfd4   3
rfphon4   1
rfatpol4  1 4
rfdir4    1 1 1

getddk4   3
prtden4   1
prepanl4  1

# --------------------------------------------------
# DS5: dkdk
# --------------------------------------------------
rf2_dkdk5  1
getddk5    3
prepanl5   1
nstep5     1
nline5     100

# --------------------------------------------------
# DS6: dkde
# --------------------------------------------------
rf2_dkde6  1
getddk6    3
get1den6   4
getdelfd6  4
getdkdk6   5
prepanl6   1
nstep6     1
nline6     100

# --------------------------------------------------
# DS7: 3rd derivatives / Raman
# --------------------------------------------------
optdriver7  5
usepead7    0

getddk7     3
get1den7    4
get1wf7     4
getdkde7    6

# Start with one phonon perturbation first, matching the t83 style
d3e_pert1_phon7  1
d3e_pert2_elfd7  1
d3e_pert3_elfd7  1

# Optional verbosity
# nonlinear_info 1

# --------------------------------------------------
# PAW files
# Replace with your actual Zn/O LDA PAW filenames
# --------------------------------------------------
pp_dirpath "."
pseudos "Zn.LDA_PW-JTH.xml, O.LDA_PW-JTH.xml"
