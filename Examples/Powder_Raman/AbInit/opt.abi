# ZnO : geometry optimization 

ndtset 2
jdtset 1 2

# --------------------------------------------------
# Structure: wurtzite ZnO primitive cell
# --------------------------------------------------
acell 6.1854168659 6.1854168660 9.9532318149 Bohr

rprim
  0.86602540378 -0.50000000000  0.00000000000
  0.00000000000  1.00000000000  0.00000000000
  0.00000000000  0.00000000000  1.00000000000

natom  4
ntypat 2
znucl  30 8
typat  1 1 2 2

xred
  0.3333333333  0.6666666667  0.0014065282
  0.6666666667  0.3333333333  0.5014065282
  0.3333333333  0.6666666667  0.3810934718
  0.6666666667  0.3333333333  0.8810934718

# --------------------------------------------------
# XC 
# --------------------------------------------------
ixc      7

# --------------------------------------------------
# Basic electronic settings
# --------------------------------------------------
nstep    100
occopt   1
nband    30

# These are only starter values. 
ecut      40
ecutsm    0.1

ngkpt    6 6 4
nshiftk  1
shiftk   0.0 0.0 0.0  # Need the gamma point

pp_dirpath "."
pseudos "Zn.psp8, O.psp8"

# ==================================================
# DATASET 1 : relax atoms only
# ==================================================
kptopt1  1
iscf1    7
tolvrs1  1.0d-8

ionmov1  2
optcell1 0
ntime1   40
tolmxf1  5.0d-5

prtden1  1
prtwf1   1

# ==================================================
# DATASET 2 : relax cell + atoms, starting from DS1
# ==================================================
getxred2 1
getwfk2  1

kptopt2  1
iscf2    7
tolvrs2  1.0d-8

ionmov2   2
optcell2  2
ntime2    40
tolmxf2   5.0d-5
ecutsm2   0.5
dilatmx2  1.05

prtden2 1
prtwf2  1

